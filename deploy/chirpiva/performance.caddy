# Include inside the chirpiva.com site. Public files live in a separate tree;
# the Caddy user never needs access to application secrets or browser profiles.
@chirpiva_setup path /api/auth/setup /api/auth/setup/*
handle @chirpiva_setup {
    respond 403
}

@chirpiva_public {
    method GET HEAD
    path /assets/* /huobao-studio/_nuxt/*
    path_regexp public_build \.(js|css|woff2?|ttf|svg|png|webp|jpe?g|gif|ico)$
    file {
        root /srv/chirpiva-public
        try_files {path}
    }
}
handle @chirpiva_public {
    root * /srv/chirpiva-public
    header Cache-Control "public, max-age=31536000, immutable"
    file_server {
        precompressed br gzip
    }
}

@chirpiva_stream path /api/chat/stream /api/chat/jobs/*/stream /api/projects/*/chat/stream /api/projects/*/chat/jobs/*/stream
handle @chirpiva_stream {
    reverse_proxy 127.0.0.1:7860 {
        flush_interval -1
    }
}

# Old tabs can still read archived chunks through the application's fallback.
handle {
    reverse_proxy 127.0.0.1:7860
}
